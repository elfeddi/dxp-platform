# DxP — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter .env dans Git

# IP publique de la VM Azure
DXP_IP=

# ArgoCD — bcrypt hash du mot de passe admin
ARGOCD_ADMIN_PASSWORD_HASH=

# Harbor
HARBOR_ADMIN_PASSWORD=

# Grafana
GRAFANA_ADMIN_PASSWORD=

# Dex GitHub OAuth
DEX_GITHUB_CLIENT_ID=
DEX_GITHUB_CLIENT_SECRET=

# Vault
VAULT_ROOT_TOKEN=

# Airflow
AIRFLOW_ADMIN_PASSWORD=

# LiteLLM
LITELLM_MASTER_KEY=

# pgvector
PGVECTOR_PASSWORD=

# ── Tokens API inter-composants C4 Gateway ──────────────────────────────────
# ArgoCD : argocd login <host> --insecure --grpc-web --grpc-web-root-path /argocd
#          argocd account generate-token --account admin
ARGOCD_API_TOKEN=

# Harbor : Harbor UI → Admin → Robot Accounts → + New Robot Account
HARBOR_API_TOKEN=

# Grafana : Grafana UI → Administration → Service Accounts → + Add service account token
GRAFANA_API_TOKEN=

# Vault : vault write auth/approle/role/dxp-c4 ... → vault write auth/approle/login
VAULT_API_TOKEN=
